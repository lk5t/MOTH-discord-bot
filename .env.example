# ───────────────────────── MOTH configuration ─────────────────────────
# Generated by install.sh. Edit with `moth config`, then `moth restart`.

# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Comma-separated Discord user IDs with access to the System page.
MOTH_OWNER_IDS=

# Public URL of the dashboard (used for OAuth redirects). No trailing slash.
DASHBOARD_URL=http://localhost:29468
DASHBOARD_PORT=29468
DASHBOARD_BIND=0.0.0.0
# Set a domain to enable automatic HTTPS via Caddy (and COMPOSE_PROFILES=https).
MOTH_DOMAIN=
COMPOSE_PROFILES=

# Secrets — generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
MOTH_ENCRYPTION_KEY=
INTERNAL_API_SECRET=

# Slash command registration: "guild" (instant, recommended) or "global".
COMMAND_SCOPE=guild
LOG_LEVEL=info

# Optional instance-wide AI provider (servers can also configure their own in the dashboard).
# Easiest: `sudo moth ai key` (API key) or `sudo moth ai local` (free local model, no key).
# AI_PROVIDER: openai | anthropic | ollama | openai-compatible | none
AI_PROVIDER=none
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_MS=
MOTH_LOCAL_AI=
# Local AI resource use: CPUs it may use (installer sets cores-1) and how long it stays loaded when idle.
OLLAMA_CPUS=
OLLAMA_KEEP_ALIVE=3m
OLLAMA_MEMORY=

# Automatic updates (checked every 3 hours). Toggle with: moth autoupdate on|off
MOTH_AUTO_UPDATE=1

# Image source & version
MOTH_IMAGE_PREFIX=ghcr.io/lk5t/moth
MOTH_VERSION=latest

# Resource limits (defaults suit a 2 GB / 2-core VPS). Raise them on bigger servers.
MOTH_BOT_MEMORY=420m
MOTH_BOT_CPUS=1.0
MOTH_DASHBOARD_MEMORY=300m
MOTH_DASHBOARD_CPUS=0.5
MOTH_DB_MEMORY=320m
MOTH_DB_CPUS=0.5
