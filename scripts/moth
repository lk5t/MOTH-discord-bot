#!/usr/bin/env bash
# moth — management CLI for a MOTH installation.
set -Eeuo pipefail

MOTH_DIR="${MOTH_DIR:-/opt/moth}"
REPO="lk5t/MOTH-discord-bot"
[[ -t 1 ]] && { R=$'\e[38;5;161m'; G=$'\e[32m'; Y=$'\e[33m'; B=$'\e[1m'; Z=$'\e[0m'; } || { R=; G=; Y=; B=; Z=; }

die() { echo "${R}✗${Z} $*" >&2; exit 1; }
need_root() { [[ $EUID -eq 0 ]] || die "This command needs root. Try: sudo moth $*"; }
[[ -d "$MOTH_DIR" && -f "$MOTH_DIR/docker-compose.yml" ]] || die "MOTH is not installed in $MOTH_DIR (set MOTH_DIR to override)."
cd "$MOTH_DIR"
dc() { docker compose "$@"; }
env_get() { grep -E "^$1=" .env 2>/dev/null | tail -1 | cut -d= -f2- || true; }
env_set() { # idempotent KEY=VALUE update of .env
  local tmp; tmp="$(mktemp)"
  if grep -qE "^$1=" .env; then awk -v k="$1" -v v="$2" -F= '$1==k {print k"="v; next} {print}' .env >"$tmp" && cat "$tmp" >.env
  else printf '%s=%s\n' "$1" "$2" >>.env; fi
  rm -f -- "$tmp"
}
stop_local_ai() { # stops and removes the Ollama container (profile services aren't removed by `up --remove-orphans`)
  docker compose --profile local-ai stop ollama >/dev/null 2>&1 || true
  docker compose --profile local-ai rm -f ollama >/dev/null 2>&1 || true
  if docker volume inspect moth_ollama-data >/dev/null 2>&1; then
    local a="y"; [[ -t 0 || -r /dev/tty ]] && read -r -p "Delete the downloaded AI model files to free disk space? [Y/n] " a </dev/tty 2>/dev/null || true
    [[ "${a:-y}" =~ ^[Yy] ]] && docker volume rm moth_ollama-data >/dev/null 2>&1 && echo "Freed the disk space used by AI models."
  fi
}
set_profile() { # set_profile NAME on|off — maintains COMPOSE_PROFILES
  local cur new p; cur="$(env_get COMPOSE_PROFILES)"; new=""
  for p in ${cur//,/ }; do [[ "$p" == "$1" ]] || new="${new:+$new,}$p"; done
  [[ "$2" == on ]] && new="${new:+$new,}$1"
  env_set COMPOSE_PROFILES "$new"
}

usage() {
  cat <<EOF
${R}moth${Z} — manage your MOTH installation (${MOTH_DIR})

  ${B}status${Z}              Service status and health
  ${B}logs${Z} [service] [-f] Show logs (bot, dashboard, postgres, migrate, caddy)
  ${B}start${Z} | ${B}stop${Z} | ${B}restart${Z} [service]
  ${B}update${Z} [version]    Upgrade now to the latest (or a specific) version — config and data are kept
  ${B}autoupdate${Z} [on|off]  Automatic updates (on by default, checked every 3 hours)
  ${B}backup${Z}              Dump the database to ${MOTH_DIR}/backups
  ${B}restore${Z} <file>      Restore a database dump (stops the bot during restore)
  ${B}config${Z}              Edit ${MOTH_DIR}/.env, then restart
  ${B}url${Z}                 Print the dashboard and bot invite URLs
  ${B}ai${Z}                  Show AI status · ${B}ai key${Z} [openai|anthropic|openrouter] · ${B}ai local${Z} [model] · ${B}ai off${Z}
                      Faster AI: ${B}moth ai local qwen2.5:1.5b${Z} · smarter (needs a strong CPU): ${B}moth ai local qwen2.5:7b${Z}
  ${B}doctor${Z}              Diagnose common problems
  ${B}version${Z}             Installed version
  ${B}uninstall${Z}           Remove MOTH (asks before deleting data)
EOF
}

cmd="${1:-help}"; shift || true
# Updates replace this script on disk — run them from a private copy.
if [[ "$cmd" =~ ^(update|upgrade)$ && -z "${MOTH_SELF_COPY:-}" ]]; then
  self="$(mktemp)"; cp "$0" "$self"; chmod 755 "$self"; MOTH_SELF_COPY="$self" MOTH_DIR="$MOTH_DIR" exec bash "$self" "$cmd" "$@"
fi
# Is the prebuilt bot image for a main commit published yet?
image_ready() {
  local repo t; repo="$(env_get MOTH_IMAGE_PREFIX)"; repo="${repo:-ghcr.io/lk5t/moth}"; repo="${repo#ghcr.io/}-bot"
  t=$(curl -fsSL "https://ghcr.io/token?scope=repository:${repo}:pull" 2>/dev/null | sed -n 's/.*"token":"\([^"]*\)".*/\1/p')
  [[ -n "$t" ]] && curl -fsSI -o /dev/null -H "Authorization: Bearer $t" \
    -H "Accept: application/vnd.oci.image.index.v1+json,application/vnd.docker.distribution.manifest.list.v2+json,application/vnd.docker.distribution.manifest.v2+json" \
    "https://ghcr.io/v2/${repo}/manifests/sha-$1"
}

case "$cmd" in
  status|ps)
    dc ps --format "table {{.Service}}\t{{.State}}\t{{.Status}}"
    echo
    port="$(env_get DASHBOARD_PORT)"
    if curl -fsS "http://127.0.0.1:${port:-29468}/api/health" >/dev/null 2>&1 || dc exec -T dashboard node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))" >/dev/null 2>&1; then echo "${G}●${Z} dashboard healthy"; else echo "${R}●${Z} dashboard unhealthy"; fi
    bot="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$(dc ps -q bot | head -1)" 2>/dev/null || echo stopped)"
    [[ "$bot" == healthy ]] && echo "${G}●${Z} bot connected to Discord" || echo "${Y}●${Z} bot: $bot"
    ;;
  logs) dc logs --tail=200 "$@" ;;
  start) need_root "$cmd"; dc up -d --remove-orphans "$@" ;;
  stop) need_root "$cmd"; dc stop "$@" ;;
  restart) need_root "$cmd"; if [[ $# -gt 0 ]]; then dc restart "$@"; else dc up -d --remove-orphans && dc restart bot dashboard; fi ;;
  update|upgrade)
    need_root "$cmd"
    auto=0; ver=""
    for a in "$@"; do case "$a" in --auto) auto=1 ;; *) ver="$a" ;; esac; done
    if [[ $auto == 1 ]]; then
      exec >>/var/log/moth-update.log 2>&1
      echo "── $(date -Is) checking for updates"
      [[ "$(env_get MOTH_AUTO_UPDATE)" == 0 ]] && { echo "auto-update disabled"; exit 0; }
      latest=$(curl -fsSL "https://api.github.com/repos/${REPO}/releases/latest" 2>/dev/null | grep -m1 '"tag_name"' | cut -d'"' -f4 || true)
      [[ -n "$latest" ]] || latest=$(curl -fsSL "https://api.github.com/repos/${REPO}/commits/main" 2>/dev/null | grep -m1 '"sha"' | cut -d'"' -f4 || true)
      [[ -n "$latest" ]] || { echo "couldn't reach GitHub; will retry later"; exit 0; }
      if [[ "$latest" == "$(env_get MOTH_INSTALLED_REF)" ]]; then echo "up to date (${latest:0:12})"; exit 0; fi
      # Main-branch commits: wait (up to 6h) for CI to publish ready-made images so the server
      # downloads them instead of building — building is what makes updates heavy on small servers.
      if [[ "$latest" =~ ^[0-9a-f]{40}$ ]] && ! image_ready "$latest"; then
        pend=/var/lib/moth-update-pending; first=$(awk -v s="$latest" '$1==s{print $2}' "$pend" 2>/dev/null || true)
        [[ -n "$first" ]] || { mkdir -p /var/lib; echo "$latest $(date +%s)" >"$pend"; first=$(date +%s); }
        if (( $(date +%s) - first < 21600 )); then echo "new version ${latest:0:12} found; waiting for its images to finish building"; exit 0; fi
        echo "images for ${latest:0:12} never appeared; building locally"
      fi
      echo "updating $(env_get MOTH_INSTALLED_REF | cut -c1-12) → ${latest:0:12}"
    fi
    echo "${B}Backing up the database first…${Z}"; bash "$0" backup
    tmp="$(mktemp)"; curl -fsSL "https://raw.githubusercontent.com/${REPO}/main/install.sh" -o "$tmp"
    MOTH_UPDATE_AUTO="${auto:-0}" MOTH_DIR="$MOTH_DIR" bash "$tmp" --unattended ${ver:+--version "$ver"}; rm -f -- "$tmp"
    # Reclaim disk from superseded images and old build cache.
    docker image prune -f >/dev/null 2>&1 || true
    docker builder prune -f --filter until=72h >/dev/null 2>&1 || true
    echo "${G}✓${Z} Update finished ($(date -Is))"
    ;;
  autoupdate)
    need_root "$cmd"
    case "${1:-status}" in
      on) env_set MOTH_AUTO_UPDATE 1; command -v systemctl >/dev/null && systemctl enable --now moth-update.timer >/dev/null 2>&1; echo "${G}✓${Z} Automatic updates on (every 3 hours)" ;;
      off) env_set MOTH_AUTO_UPDATE 0; command -v systemctl >/dev/null && systemctl disable --now moth-update.timer >/dev/null 2>&1; rm -f /etc/cron.d/moth-update; echo "Automatic updates off" ;;
      *) echo "Automatic updates: $([[ "$(env_get MOTH_AUTO_UPDATE)" == 0 ]] && echo off || echo on) · installed: $(env_get MOTH_INSTALLED_REF | cut -c1-12)"
         command -v systemctl >/dev/null && systemctl list-timers moth-update.timer --no-pager 2>/dev/null | sed -n '1,2p'
         [[ -f /var/log/moth-update.log ]] && { echo "Last checks:"; tail -n 5 /var/log/moth-update.log; } ;;
    esac ;;
  backup)
    need_root "$cmd"
    mkdir -p backups
    f="backups/moth-$(date +%Y%m%d-%H%M%S).sql.gz"
    dc exec -T postgres sh -c 'pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" --no-owner --clean --if-exists' | gzip -9 >"$f"
    chmod 600 "$f"
    # Keep the 20 most recent dumps.
    ls -1t backups/moth-*.sql.gz 2>/dev/null | tail -n +21 | xargs -r rm -f --
    echo "${G}✓${Z} Database backed up to ${MOTH_DIR}/$f ($(du -h "$f" | cut -f1))"
    ;;
  restore)
    need_root "$cmd"
    f="${1:-}"; [[ -f "$f" ]] || die "Usage: moth restore <backup.sql.gz>"
    read -r -p "This replaces the current database with $f. Type RESTORE to continue: " c </dev/tty
    [[ "$c" == "RESTORE" ]] || die "Cancelled."
    bash "$0" backup
    dc stop bot dashboard
    if [[ "$f" == *.gz ]]; then gunzip -c "$f"; else cat "$f"; fi | dc exec -T postgres sh -c 'psql -q -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB"'
    dc up -d
    echo "${G}✓${Z} Restored from $f"
    ;;
  config) need_root "$cmd"; "${EDITOR:-nano}" .env && read -r -p "Restart MOTH to apply? [Y/n] " a </dev/tty && [[ "${a:-y}" =~ ^[Yy] ]] && dc up -d --force-recreate bot dashboard ;;
  url)
    echo "Dashboard:  $(env_get DASHBOARD_URL)"
    echo "OAuth redirect (add in Discord portal): $(env_get DASHBOARD_URL)/api/auth/callback"
    echo "Invite:     https://discord.com/oauth2/authorize?client_id=$(env_get DISCORD_CLIENT_ID)&permissions=8&scope=bot%20applications.commands"
    ;;
  version) echo "MOTH $(env_get MOTH_VERSION) · build $(env_get MOTH_INSTALLED_REF | cut -c1-12) · $(docker compose version --short 2>/dev/null | sed 's/^/compose /')" ;;
  doctor)
    ok() { echo "${G}✓${Z} $*"; }; bad() { echo "${R}✗${Z} $*"; }
    docker info >/dev/null 2>&1 && ok "Docker daemon running" || bad "Docker daemon not running"
    for k in DISCORD_TOKEN DISCORD_CLIENT_ID DISCORD_CLIENT_SECRET POSTGRES_PASSWORD MOTH_ENCRYPTION_KEY INTERNAL_API_SECRET DASHBOARD_URL; do [[ -n "$(env_get $k)" ]] && ok "$k set" || bad "$k missing in .env"; done
    tok="$(env_get DISCORD_TOKEN)"
    me=$(curl -fsS -H "Authorization: Bot $tok" https://discord.com/api/v10/users/@me 2>/dev/null || true)
    [[ -n "$me" ]] && ok "Discord accepts the bot token" || bad "Discord rejected the bot token"
    app=$(curl -fsS -H "Authorization: Bot $tok" https://discord.com/api/v10/applications/@me 2>/dev/null || true)
    if [[ -n "$app" ]]; then
      flags=$(printf '%s' "$app" | grep -o '"flags":[0-9]*' | head -1 | cut -d: -f2)
      (( (${flags:-0} & (1<<15 | 1<<14)) )) && ok "Server Members intent enabled" || bad "Enable 'Server Members Intent' on the Bot tab"
      (( (${flags:-0} & (1<<19 | 1<<18)) )) && ok "Message Content intent enabled" || bad "Enable 'Message Content Intent' on the Bot tab"
    fi
    dc ps --format '{{.Service}} {{.State}}' | while read -r s st; do [[ "$st" == running ]] && ok "$s running" || bad "$s $st"; done
    df -Pk . | awk 'NR==2 { if ($4 < 1048576) print "'"${Y}"'!'"${Z}"' Less than 1 GB free disk space" }'
    ;;
  ai)
    sub="${1:-status}"; shift || true
    case "$sub" in
      status)
        p="$(env_get AI_PROVIDER)"
        if [[ -z "$p" || "$p" == none ]]; then echo "AI: ${Y}not configured${Z} — run ${B}sudo moth ai key${Z} (API key) or ${B}sudo moth ai local${Z} (free, no key)"
        else echo "AI: ${G}${p}${Z} · model $(env_get AI_MODEL)$( [[ -n "$(env_get AI_API_KEY)" ]] && echo " · key set")"
          [[ "$p" == ollama ]] && { dc exec -T ollama ollama list 2>/dev/null || echo "${Y}!${Z} ollama container not running"; }
        fi
        echo "Servers can also add their own provider in the dashboard → AI Settings." ;;
      key)
        need_root ai
        prov="${1:-}"
        if [[ -z "$prov" ]]; then read -r -p "Provider — 1) OpenAI  2) Anthropic  3) OpenRouter [1]: " c </dev/tty; case "$c" in 2) prov=anthropic ;; 3) prov=openrouter ;; *) prov=openai ;; esac; fi
        case "$prov" in openai) url=https://platform.openai.com/api-keys; model=gpt-4.1-mini ;; anthropic) url=https://console.anthropic.com/settings/keys; model=claude-sonnet-5-5 ;; openrouter) url=https://openrouter.ai/keys; model=openrouter/auto ;; *) die "Unknown provider $prov (openai, anthropic, openrouter)" ;; esac
        echo "Get a key at ${B}${url}${Z}"
        read -r -s -p "API key: " key </dev/tty; echo
        [[ -n "$key" ]] || die "No key entered."
        case "$prov" in
          openai) code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 -H "Authorization: Bearer $key" https://api.openai.com/v1/models) ;;
          anthropic) code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 -H "x-api-key: $key" -H "anthropic-version: 2023-06-01" https://api.anthropic.com/v1/models) ;;
          openrouter) code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 -H "Authorization: Bearer $key" https://openrouter.ai/api/v1/auth/key) ;;
        esac
        [[ "$code" == 401 || "$code" == 403 ]] && die "The provider rejected that key."
        [[ "$code" == 200 ]] && echo "${G}✓${Z} Key accepted" || echo "${Y}!${Z} Couldn't verify the key (HTTP $code); saving anyway."
        read -r -p "Model [$model]: " m </dev/tty; model="${m:-$model}"
        if [[ "$prov" == openrouter ]]; then env_set AI_PROVIDER openai-compatible; env_set AI_BASE_URL https://openrouter.ai/api/v1; else env_set AI_PROVIDER "$prov"; env_set AI_BASE_URL ""; fi
        env_set AI_API_KEY "$key"; env_set AI_MODEL "$model"; env_set AI_TIMEOUT_MS ""; env_set MOTH_LOCAL_AI ""; env_set MOTH_AI_DISABLED ""
        set_profile local-ai off; stop_local_ai
        dc up -d --remove-orphans >/dev/null && dc up -d --force-recreate bot dashboard
        echo "${G}✓${Z} AI enabled: $prov · $model" ;;
      local)
        need_root ai
        ram=$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo)
        cores=$(nproc 2>/dev/null || echo 2)
        def=qwen2.5:1.5b; [[ $ram -ge 3800 ]] && def=qwen2.5:3b; [[ $ram -ge 7500 && $cores -ge 8 ]] && def=qwen2.5:7b
        model="${1:-$def}"
        # An explicitly chosen model is kept across updates; the automatic choice may be improved by updates.
        if [[ -n "${1:-}" ]]; then env_set MOTH_LOCAL_MODEL_PINNED 1; else env_set MOTH_LOCAL_MODEL_PINNED ""; fi
        [[ $ram -lt 3800 ]] && echo "${Y}!${Z} ${ram} MB RAM: local AI will be slow and basic. An API key gives far better results."
        env_set MOTH_AI_DISABLED ""; env_set AI_PROVIDER ollama; env_set AI_MODEL "$model"; env_set AI_BASE_URL http://ollama:11434/v1; env_set AI_API_KEY ""; env_set AI_TIMEOUT_MS 600000; env_set MOTH_LOCAL_AI 1
        set_profile local-ai on
        cores=$(nproc 2>/dev/null || echo 2); env_set OLLAMA_CPUS "$(( cores > 1 ? cores - 1 : 1 ))"
        dc up -d ollama
        for _ in $(seq 1 30); do dc exec -T ollama ollama list >/dev/null 2>&1 && break; sleep 2; done
        echo "Downloading ${model} (one-time)…"
        old="$(dc exec -T ollama ollama list 2>/dev/null | awk 'NR>1 {print $1}' | grep -vx "$model" || true)"
        dc exec -T ollama ollama pull "$model"
        for o in $old; do dc exec -T ollama ollama rm "$o" >/dev/null 2>&1 || true; done   # free disk from older models
        dc up -d --force-recreate bot dashboard
        echo "${G}✓${Z} Free local AI enabled: $model (no API key needed)" ;;
      off)
        need_root ai
        env_set AI_PROVIDER none; env_set AI_API_KEY ""; env_set MOTH_LOCAL_AI ""; env_set MOTH_AI_DISABLED 1
        set_profile local-ai off; stop_local_ai
        dc up -d --remove-orphans >/dev/null && dc up -d --force-recreate bot dashboard
        echo "${G}✓${Z} AI turned off — its memory and CPU are freed. Everything else, including the Architect's built-in designer, keeps working."
        echo "  Turn it back on any time: sudo moth ai local" ;;
      *) die "Usage: moth ai [status|key|local [model]|off]" ;;
    esac ;;
  uninstall)
    need_root "$cmd"
    read -r -p "Stop and remove MOTH containers? [y/N] " a </dev/tty; [[ "$a" =~ ^[Yy] ]] || exit 0
    read -r -p "Also DELETE the database and all data? Type DELETE to confirm, anything else keeps data: " d </dev/tty
    if [[ "$d" == "DELETE" ]]; then dc down -v; else dc down; fi
    if command -v systemctl >/dev/null 2>&1; then systemctl disable --now moth.service moth-update.timer >/dev/null 2>&1 || true; rm -f /etc/systemd/system/moth.service /etc/systemd/system/moth-update.service /etc/systemd/system/moth-update.timer; systemctl daemon-reload || true; fi
    rm -f /etc/cron.d/moth-update
    echo "Containers removed. Files remain in $MOTH_DIR (backups included); delete that directory manually if you no longer need it."
    rm -f /usr/local/bin/moth
    ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
